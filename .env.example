# Необязательно. Чтобы переопределить значения из .env.development, скопируйте
# этот файл в .env.local (он не попадает в git) и измените нужное.
VITE_API_BASE_URL=/api
VITE_EXPORT_BASE_URL=/api
VITE_WS_URL=ws://localhost:5173/api/v1/ws/sensors

# Куда Vite-прокси отправляет /api (читается в vite.config.ts, префикс VITE_ не нужен).
# По умолчанию http://localhost:8002. Меняйте, если бэкенд на другом порту:
# API_PROXY_TARGET=http://localhost:8010
